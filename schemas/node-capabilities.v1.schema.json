{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "node-capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "nodeId",
    "capabilities",
    "runtime"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "enum": [
        "simulation",
        "disabled"
      ]
    },
    "nodeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]+$"
      }
    },
    "runtime": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    }
  }
}
