{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "authority-grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "principal",
    "accountScope",
    "allowedActions",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "enum": [
        "simulation",
        "disabled"
      ]
    },
    "principal": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "accountScope": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "allowedActions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]+$"
      }
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
