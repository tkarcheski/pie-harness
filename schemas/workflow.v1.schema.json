{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workflow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "workflowId",
    "steps",
    "retryLimit",
    "deadlineSeconds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "enum": [
        "simulation",
        "disabled"
      ]
    },
    "workflowId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]+$"
      }
    },
    "retryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "deadlineSeconds": {
      "type": "integer",
      "minimum": 1
    }
  }
}
