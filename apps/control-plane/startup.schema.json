{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "connectorsEnabled",
    "node",
    "heartbeatMs",
    "leaseMs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "const": "fixture"
    },
    "connectorsEnabled": {
      "const": false
    },
    "node": {
      "type": "string",
      "minLength": 1
    },
    "heartbeatMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000
    },
    "leaseMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000
    }
  }
}
